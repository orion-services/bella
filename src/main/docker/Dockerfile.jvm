####
# Multi-stage build: Vue frontend (Vite) -> Quarkus JVM package -> JRE runtime.
#
# Mirrors the pattern used by the RAG project (see its Dockerfile), adapted to TWR's
# EC2/Docker Compose deployment (see docker-compose.yml and docs/aws.md).
#
# Build with (normally done for you by docker-compose.yml / the GitHub Actions
# deploy workflow — see the "args" under the twr service):
#
#   docker build -f src/main/docker/Dockerfile.jvm \
#     --build-arg VITE_API_BASE_URL= \
#     --build-arg VITE_ORION_USERS_URL=https://users.example.com \
#     --build-arg VITE_GOOGLE_CLIENT_ID= \
#     -t twr .
####

# ------------------------------------------------------------------------------
# Stage 1: Build frontend (Vue/Vite) — output goes to
# src/main/resources/META-INF/resources, replacing the previous static index.html.
# ------------------------------------------------------------------------------
FROM node:20-alpine AS frontend
WORKDIR /app
COPY . /app
WORKDIR /app/frontend

# Vite bakes VITE_* variables into the client bundle at build time. .dockerignore
# excludes .env files from the build context (they may contain secrets and are not
# meant to be baked into a shared image), so production values must be passed as
# --build-arg instead (see docker-compose.yml, service "twr", "build.args").
#
# VITE_API_BASE_URL defaults to "" (empty = same-origin) because the frontend is
# served by this same Quarkus app in production.
ARG VITE_API_BASE_URL=""
ARG VITE_ORION_USERS_URL=""
ARG VITE_GOOGLE_CLIENT_ID=""
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL} \
    VITE_ORION_USERS_URL=${VITE_ORION_USERS_URL} \
    VITE_GOOGLE_CLIENT_ID=${VITE_GOOGLE_CLIENT_ID}

RUN npm ci && npm run build

# ------------------------------------------------------------------------------
# Stage 2: Build JVM (Maven + JDK) — frontend already built in stage 1, so the
# frontend-maven-plugin execution is skipped here (-DskipFrontend=true).
# ------------------------------------------------------------------------------
FROM maven:3.9-eclipse-temurin-25-alpine AS jvm-build
WORKDIR /build

COPY --from=frontend /app/pom.xml .
COPY --from=frontend /app/mvnw .
COPY --from=frontend /app/.mvn .mvn
COPY --from=frontend /app/src src

RUN ./mvnw package -DskipTests=true -DskipITs=true -DskipFrontend=true

# ------------------------------------------------------------------------------
# Stage 3: Runtime (JRE)
# ------------------------------------------------------------------------------
FROM eclipse-temurin:25-jre
WORKDIR /work

RUN useradd -u 1001 -m jvm && chown -R jvm:jvm /work

COPY --from=jvm-build --chown=jvm:jvm /build/target/quarkus-app/lib/ /work/lib/
COPY --from=jvm-build --chown=jvm:jvm /build/target/quarkus-app/*.jar /work/
COPY --from=jvm-build --chown=jvm:jvm /build/target/quarkus-app/app/ /work/app/
COPY --from=jvm-build --chown=jvm:jvm /build/target/quarkus-app/quarkus/ /work/quarkus/

# Base RAG documents (PDF, text, etc.) ingested on startup. In dev this is read
# straight from src/main/resources/rag (relative path); in prod it must be an
# absolute path inside the image (see %prod.rag.location / application-prod.properties).
COPY --from=frontend --chown=jvm:jvm /app/src/main/resources/rag /work/rag

ENV QUARKUS_PROFILE=prod
ENV RAG_LOCATION=/work/rag

EXPOSE 8080
USER jvm

ENTRYPOINT ["java", "-Dquarkus.http.host=0.0.0.0", "-Dquarkus.http.port=8080", "-jar", "/work/quarkus-run.jar"]
